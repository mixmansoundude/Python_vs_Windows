set "HP_EXPAT_DLL="
for %%I in ("%HP_PY%") do set "HP_PY_DIR=%%~dpI"
if defined HP_PY_DIR for /f "delims=" %%D in ('dir /b /a-d "%HP_PY_DIR%Library\bin\libexpat*.dll" 2^>nul') do if not defined HP_EXPAT_DLL set "HP_EXPAT_DLL=%HP_PY_DIR%Library\bin\%%D"
